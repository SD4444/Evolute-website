{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "evolute-website",
  "account_id": "fd094acec35a1d8a40701a14a7e26e56",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": true,
  },
  // Contact form storage. Create the database and paste its id here:
  //   npx wrangler d1 create evolute-contact-submissions
  //   npx wrangler d1 execute evolute-contact-submissions --remote \
  //     --file migrations/0001_create_submissions.sql
  // Until this is bound, the form reports its error state ("email us directly")
  // rather than falsely confirming receipt.
  // "d1_databases": [
  //   {
  //     "binding": "CONTACT_SUBMISSIONS",
  //     "database_name": "evolute-contact-submissions",
  //     "database_id": "<paste-id-here>",
  //   },
  // ],
}
