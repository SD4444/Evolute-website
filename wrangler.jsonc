{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "evolute-website",
  "account_id": "fd094acec35a1d8a40701a14a7e26e56",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": true,
  },
  // Contact form notifications. RESEND_API_KEY is a secret, set out of band with
  // `npx wrangler secret put`. CONTACT_NOTIFY_TO defaults to info@evolute.partners.
  "vars": {
    "CONTACT_NOTIFY_FROM": "website@evolute.partners",
  },
  // Contact form storage. Schema lives in migrations/; apply with:
  //   npx wrangler d1 execute evolute-contact-submissions --remote \
  //     --file migrations/0001_create_submissions.sql
  "d1_databases": [
    {
      "binding": "CONTACT_SUBMISSIONS",
      "database_name": "evolute-contact-submissions",
      "database_id": "aca27a09-ca83-4231-a857-408c3065b8a3",
    },
  ],
}
